<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <env name="APP_ENV" value="testing"/>
        <env name="APP_KEY" value="base64:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA="/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="BROADCAST_CONNECTION" value="null"/>
        <env name="CACHE_STORE" value="array"/>
        <!--
            Sem DB_CONNECTION aqui: o app usa jsonb e índices parciais via
            DB::statement, que não existem em SQLite. A suíte precisa de um
            Postgres de verdade - o servidor vem do ambiente (docker-compose
            em stage, serviço postgres no CI), nunca é forçada pra sqlite.

            O banco, esse sim, é forçado: a suíte usa RefreshDatabase e
            truncaria o banco da aplicação se herdasse DB_DATABASE do
            ambiente. Foi o que aconteceu na Stage em 2026-08-22 (categorias,
            tabela de preço e usuários zerados por um `artisan test`). Criar o
            banco antes de rodar: `docker/init-test-db.sh` cuida disso em
            ambiente novo, o CI sobe o serviço já com esse nome.
        -->
        <!--
            <env> e <server>: o config do Laravel lê $_SERVER, então só o <env>
            não segura quando a variável já vem do ambiente do container (mesmo
            motivo do MAIL_MAILER logo abaixo).
        -->
        <env name="DB_DATABASE" value="resolve_plus_test" force="true"/>
        <server name="DB_DATABASE" value="resolve_plus_test" force="true"/>
        <env name="MAIL_MAILER" value="array" force="true"/>
        <server name="MAIL_MAILER" value="array" force="true"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <env name="NIGHTWATCH_ENABLED" value="false"/>
        <!--
            Estes três também precisam do par <env>/<server>: o container de
            stage passou a receber ASAAS_WEBHOOK_TOKEN de verdade pelo compose,
            e só com <env> a suíte herdava o token real e tomava 401 no webhook.
            Mesma armadilha do DB_DATABASE e do MAIL_MAILER acima.
        -->
        <env name="OBJECT_STORAGE_DISK" value="s3" force="true"/>
        <server name="OBJECT_STORAGE_DISK" value="s3" force="true"/>
        <env name="PAYMENT_GATEWAY" value="fake" force="true"/>
        <server name="PAYMENT_GATEWAY" value="fake" force="true"/>
        <env name="ASAAS_WEBHOOK_TOKEN" value="test-webhook-token" force="true"/>
        <server name="ASAAS_WEBHOOK_TOKEN" value="test-webhook-token" force="true"/>
    </php>
</phpunit>
